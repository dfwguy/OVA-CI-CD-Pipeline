[Unit]
Description=NVIS-OVA CI/CD Hub production container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=nvis-ova-hub
Image=localhost/nvis-ova-hub:local
PublishPort=0.0.0.0:8787:8787
Environment=NVIS_CONFIG=/config/config.toml
Environment=NVIS_WEB_ROOT=/app/web
Environment=NVIS_AUTH_RECORDS=%h/cicd-hub/runtime/secrets/portal-auth.json
Environment=NVIS_SESSION_SECRET=%h/cicd-hub/runtime/secrets/session-secret
Environment=NVIS_CREDENTIAL_ROOT=%h/cicd-hub/runtime/secrets
Environment=NVIS_INSECURE_HTTP=true
Volume=%h/cicd-hub/runtime/config.toml:/config/config.toml:ro
Volume=%h/cicd-hub/runtime/data:%h/cicd-hub/runtime/data:rw
Volume=%h/cicd-hub/runtime/secrets:%h/cicd-hub/runtime/secrets:rw
Volume=%h/.ssh/id_ed25519_nvftp:%h/.ssh/id_ed25519_nvftp:ro
Volume=%h/.ssh/known_hosts:%h/.ssh/known_hosts:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PidsLimit=256
Memory=2g
HealthCmd=python -m nvis_integration.container_health
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=15s
HealthRetries=3
HealthOnFailure=kill
HealthMaxLogCount=5
HealthMaxLogSize=1024
PodmanArgs=--user=0
PodmanArgs=--tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=default.target
